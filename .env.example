# ICON Email & Browser Lab

Local environment configuration.

Copy this file to `.env` and fill in your values.

## General

APP_ENV=development
APP_PORT=3000

## Database

DATABASE_PATH=./data/icon-lab.db

## Email Providers (configure per provider)

# IMAP
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=

# Gmail (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Microsoft Graph / Outlook (OAuth2)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

## Browser

BROWSER_PROFILES_DIR=./data/browser-profiles

## Playwright

# Set to true to install browsers on first run
PLAYWRIGHT_INSTALL_BROWSERS=false

## Automation

# Default test timeout in ms
TEST_TIMEOUT_MS=30000

## Security

# NEVER commit this file. Always use .env.local for secrets.

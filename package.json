{
  "name": "icon-email-browser-lab",
  "version": "1.0.0",
  "private": true,
  "description": "ICON Email & Browser Lab — local-first desktop/web application for managing email identities, authorized inboxes, OTP/verification messages, browser profiles, sessions, and automated QA/testing workflows.",
  "author": "ICON Studios (Penn Divine Favour)",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch apps/web/src/main.tsx",
    "build": "tsc && vite build",
    "build:desktop": "echo 'Tauri build placeholder — see docs'",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "format": "prettier --write \"packages/**/*.ts\" \"apps/**/*.ts\" \"apps/**/*.tsx\""
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.11.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0"
  }
}
